<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7"
    tools:context=".MainActivity">


    <!-- =============================== -->
    <!-- CABEÇALHO -->
    <!-- =============================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_header"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <TextView
            android:id="@+id/txtLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RelateSBC"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/txtArvore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🌳"
            android:textSize="28sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/txtLogo"
            app:layout_constraintTop_toTopOf="parent" />


        <Button
            android:id="@+id/btnNovaDenuncia"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:backgroundTint="#87966C"
            android:text="+ Nova denúncia"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- =============================== -->
    <!-- ÁREA DO TÍTULO + FILTROS -->
    <!-- =============================== -->

    <LinearLayout
        android:id="@+id/areaFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#E7ECE8"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mural de Denúncias"
            android:textColor="#111111"
            android:textSize="32sp"
            android:textStyle="bold" />


        <!-- FILTROS -->

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Todos"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#AAB590"
                    app:cornerRadius="14dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLixo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="Lixo"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#AAB590"
                    app:cornerRadius="14dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIluminacao"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="Iluminação"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#AAB590"
                    app:cornerRadius="14dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPavimentacao"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="Pavimentação"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#AAB590"
                    app:cornerRadius="14dp" />


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOutros"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:text="Outros"
                    android:textAllCaps="false"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#AAB590"
                    app:cornerRadius="14dp" />

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>


    <!-- =============================== -->
    <!-- LISTA DE DENÚNCIAS -->
    <!-- ESSA PARTE ROLA -->
    <!-- =============================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerItens"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/areaFiltros"
        tools:listitem="@layout/item_card" />


    <!-- Quando não tiver denúncia -->

    <TextView
        android:id="@+id/textSemResultados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nenhuma denúncia encontrada."
        android:textColor="#666666"
        android:textSize="17sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/areaFiltros" />


    <!-- =============================== -->
    <!-- BARRA INFERIOR FIXA -->
    <!-- =============================== -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="#4D7048"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <Button
            android:id="@+id/btnMain"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:backgroundTint="#A3B386"
            android:text="Main"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDenuncia"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <Button
            android:id="@+id/btnDenuncia"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:backgroundTint="#87966C"
            android:text="Denúncia"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnUser"
            app:layout_constraintStart_toEndOf="@id/btnMain"
            app:layout_constraintTop_toTopOf="parent" />


        <Button
            android:id="@+id/btnUser"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:backgroundTint="#87966C"
            android:text="User"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnDenuncia"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>