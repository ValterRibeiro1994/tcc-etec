<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"

    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="#222222"
    app:strokeWidth="2dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <!-- FOTO -->

        <ImageView
            android:id="@+id/cardFoto"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="#DDDDDD"
            android:contentDescription="Foto da denúncia"
            android:scaleType="centerCrop" />


        <!-- INFORMAÇÕES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- STATUS + TEMPO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:id="@+id/cardStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Em andamento"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />


                <TextView
                    android:id="@+id/cardTempo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="agora"
                    android:textColor="#333333"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- TÍTULO -->

            <TextView
                android:id="@+id/cardTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Buraco na rua"
                android:textColor="#111111"
                android:textSize="24sp"
                android:textStyle="bold" />


            <!-- CATEGORIA -->

            <TextView
                android:id="@+id/cardCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pavimentação"
                android:textColor="#667257"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- DESCRIÇÃO -->

            <TextView
                android:id="@+id/cardDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tampa de bueiro quebrada podendo causar acidentes."
                android:textColor="#222222"
                android:textSize="16sp" />


            <!-- ENDEREÇO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌖"
                    android:textColor="#111111"
                    android:textSize="28sp" />


                <TextView
                    android:id="@+id/cardEndereco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Rua relateSBC 203"
                    android:textColor="#222222"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>