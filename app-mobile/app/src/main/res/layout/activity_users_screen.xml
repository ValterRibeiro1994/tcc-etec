<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".UsersScreen">


    <!-- ================================================= -->
    <!-- CONTEÚDO RESPONSIVO -->
    <!-- ================================================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollUser"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="650dp">


            <!-- ============================================= -->
            <!-- FUNDO VERDE -->
            <!-- ============================================= -->

            <View
                android:id="@+id/topBackground"
                android:layout_width="0dp"
                android:layout_height="230dp"
                android:background="#264D26"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- ============================================= -->
            <!-- FOTO / INICIAL -->
            <!-- ============================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfile"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginTop="145dp"
                app:cardBackgroundColor="#F3A24F"
                app:cardCornerRadius="65dp"
                app:cardElevation="0dp"
                app:strokeColor="#000000"
                app:strokeWidth="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/txtInicial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="#000000"
                    android:textSize="52sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>


            <!-- ============================================= -->
            <!-- NOME -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/txtName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Usuário"
                android:textColor="#111111"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/cardProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- ============================================= -->
            <!-- EMAIL -->
            <!-- ============================================= -->

            <TextView
                android:id="@+id/txtEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="usuario@email.com"
                android:textColor="#555555"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/txtName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <!-- ============================================= -->
            <!-- ESTATÍSTICAS -->
            <!-- ============================================= -->

            <LinearLayout
                android:id="@+id/layoutEstatisticas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:gravity="top"
                app:layout_constraintTop_toBottomOf="@id/txtEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">


                <!-- SOLICITAÇÕES -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_stat"
                        android:gravity="center"
                        android:text="☷"
                        android:textColor="#000000"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/txtSolicitacoes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="#111111"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Solicitações"
                        android:textColor="#222222"
                        android:textSize="13sp" />

                </LinearLayout>


                <!-- RESOLVIDAS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_stat"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#000000"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/txtResolvidas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="#111111"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Resolvidas"
                        android:textColor="#222222"
                        android:textSize="13sp" />

                </LinearLayout>


                <!-- ANDAMENTO -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_circle_stat"
                        android:gravity="center"
                        android:text="◷"
                        android:textColor="#000000"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/txtAndamento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="#111111"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Andamento"
                        android:textColor="#222222"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ============================================= -->
            <!-- OPÇÕES -->
            <!-- ============================================= -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOpcoes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="25dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="25dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#444444"
                app:strokeWidth="2dp"
                app:layout_constraintTop_toBottomOf="@id/layoutEstatisticas"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">


                    <!-- MODO ESCURO -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDarkMode"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:text="☾   Modo escuro"
                        android:textAllCaps="false"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="14dp"
                        app:strokeColor="#222222"
                        app:strokeWidth="2dp" />


                    <!-- SAIR -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="10dp"
                        android:text="→   Sair da conta"
                        android:textAllCaps="false"
                        android:textColor="#111111"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="14dp"
                        app:strokeColor="#222222"
                        app:strokeWidth="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ================================================= -->
    <!-- BARRA INFERIOR FIXA -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:background="#4D7048"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <Button
            android:id="@+id/btnMain"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#87966C"
            android:text="Main"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"
            app:layout_constraintWidth_percent="0.27"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <Button
            android:id="@+id/btnDenuncia"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#87966C"
            android:text="Denúncia"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:cornerRadius="14dp"
            app:layout_constraintWidth_percent="0.34"
            app:layout_constraintStart_toEndOf="@id/btnMain"
            app:layout_constraintEnd_toStartOf="@id/btnUser"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


        <Button
            android:id="@+id/btnUser"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#A3B386"
            android:text="User"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:layout_constraintWidth_percent="0.27"
            app:layout_constraintStart_toEndOf="@id/btnDenuncia"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>